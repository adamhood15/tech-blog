<section class="text-center reveal">
    <span class="section-eyebrow">Your Workspace</span>
    <h1 class="page-title">My Dashboard</h1>
    <p class="page-subtitle">Everything you've written, in one place.</p>
</section>

{{#if loggedIn}}
<div class="card-stack" data-stagger="80">
    {{#each blog}}
    <a href="/api/blog/{{id}}/update" class="post-card reveal">
        <h5 class="post-card-title">{{title}}</h5>
        <div class="card-meta">
            <span class="meta-date">{{date}}</span>
        </div>
        <p class="post-card-excerpt">{{content}}</p>
        <span class="read-more">
            Edit post
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </span>
    </a>
    {{else}}
    <div class="empty-state reveal">
        <p>You haven't written anything yet. Start your first post below.</p>
    </div>
    {{/each}}

    <form action="/create" method="GET" class="reveal" style="text-align:center; margin-top:.5rem;">
        <button type="submit" class="btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
            New Post
        </button>
    </form>
</div>
{{else}}
<div class="empty-state reveal">
    <p>Please <a href="/login">log in</a> to view your dashboard.</p>
</div>
{{/if}}
