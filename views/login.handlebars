<section class="text-center reveal">
    <span class="section-eyebrow">Welcome back</span>
    <h1 class="page-title">Log In</h1>
    <p class="page-subtitle">Sign in to read, write and comment.</p>
</section>

<form id="login-form" class="form-card reveal">
    <div class="field">
        <label for="login-username">Username</label>
        <input type="text" id="login-username" placeholder="Lernantino" required>
    </div>
    <div class="field">
        <label for="login-password">Password</label>
        <input type="password" id="login-password" placeholder="••••••••" required>
    </div>
    <button type="submit" class="btn">Log In</button>
    <p class="form-switch">Not a member? <a href="/signup">Sign Up</a></p>
</form>
<script src="/js/login.js"></script>
