<section class="text-center reveal">
    <span class="section-eyebrow">Join in</span>
    <h1 class="page-title">Sign Up</h1>
    <p class="page-subtitle">Create an account to start posting.</p>
</section>

<form id="signup-form" class="form-card reveal">
    <div class="field">
        <label for="signup-username">Username</label>
        <input type="text" id="signup-username" placeholder="Lernantino" required>
    </div>
    <div class="field">
        <label for="signup-password">Password</label>
        <input type="password" id="signup-password" placeholder="••••••••" required>
    </div>
    <button type="submit" class="btn">Sign Up</button>
    <p class="form-switch">Already a user? <a href="/login">Log In</a></p>
</form>
<script src="/js/signup.js"></script>
