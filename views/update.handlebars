<section class="text-center reveal">
    <span class="section-eyebrow">Revise</span>
    <h1 class="page-title">Update Post</h1>
    <p class="page-subtitle">Edit or remove this post.</p>
</section>

<form id="update-delete-form" class="form-card wide reveal">
    <p id="author-id">{{blog.author_id}}</p>
    <div class="field">
        <label for="update-title">Title</label>
        <textarea id="update-title" rows="1">{{blog.title}}</textarea>
    </div>
    <div class="field">
        <label for="update-content">Content</label>
        <textarea id="update-content" rows="8">{{blog.content}}</textarea>
    </div>
    <div class="btn-row">
        <button type="submit" name="action" value="update" class="btn">Update</button>
        <button id="delete" type="submit" name="action" value="delete">Delete</button>
    </div>
</form>
<script src="/js/updateDelete.js"></script>
