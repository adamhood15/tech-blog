<section class="text-center reveal">
    <span class="section-eyebrow">Compose</span>
    <h1 class="page-title">Create Post</h1>
    <p class="page-subtitle">Share something you've learned.</p>
</section>

<form id="new-blog-form" class="form-card wide reveal">
    <div class="field">
        <label for="blog-title">Title</label>
        <textarea id="blog-title" rows="1" placeholder="A short, sharp headline"></textarea>
    </div>
    <div class="field">
        <label for="blog-content">Content</label>
        <textarea id="blog-content" rows="8" placeholder="Write your post..."></textarea>
    </div>
    <button type="submit" class="btn">
        Publish
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4Z"/></svg>
    </button>
</form>
<script src="/js/createBlog.js"></script>
