<article class="card-stack" data-stagger="90">
    <a href="/" class="post-card reveal">
        <h5 class="post-card-title">{{blog.title}}</h5>
        <div class="card-meta">
            <span class="avatar">{{initial blog.user.username}}</span>
            <span class="meta-author">{{#if blog.user.username}}{{blog.user.username}}{{else}}Anonymous{{/if}}</span>
            <span class="dot"></span>
            <span class="meta-date">{{blog.date}}</span>
        </div>
        <p>{{blog.content}}</p>
    </a>

    <section class="reveal">
        <h4 class="text-center" style="margin-bottom:.25rem;">Comment Section</h4>
        <p class="page-subtitle" style="margin-bottom:1rem;">
            {{#if blog.comments}}What the community is saying{{else}}No thoughts shared yet{{/if}}
        </p>

        <div class="comment-section scrollbar-hide">
            {{#if blog.comments}}
                {{#each blog.comments}}
                    <div class="comment-box">
                        <a href="/api/blog/{{id}}/update" class="comment-card">
                            <p>{{content}}</p>
                            <p class="comment-author">{{user.username}}</p>
                            <p class="comment-date">{{date}}</p>
                        </a>
                    </div>
                {{/each}}
            {{else}}
                <div class="empty-state">
                    <p>No one has commented yet. Start the conversation.</p>
                </div>
            {{/if}}
        </div>
    </section>

    <form id="comment-form" class="form-card wide reveal">
        <input type="hidden" id="author-id">
        <div class="field">
            <label for="comment-content">Your comment</label>
            <textarea id="comment-content" rows="4" placeholder="Leave a comment..."></textarea>
        </div>
        <button type="submit" class="btn">
            Post Comment
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4Z"/></svg>
        </button>
    </form>
</article>
<script src="/js/comment.js"></script>
